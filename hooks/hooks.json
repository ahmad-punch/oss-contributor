{
  "description": "oss-contributor: block AI co-author trailers in repos that opt in",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/block-ai-trailers.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
