{
  "description": "oss-contributor: block AI co-author trailers where a repo opts in, and remind of the project's AI policy at session start",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/block-ai-trailers.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/policy-reminder.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
